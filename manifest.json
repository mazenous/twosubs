{
  "manifest_version": 3,
  "name": "Twosubs",
  "version": "1.0",

  "description": "Adds two subtitles to Youtube videos.",

  "icons": {
    "48": "src/icons/twosubs.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "twosubs@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "tabs", "storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["dist-content/content.js"]
    }
  ],
  "action": {
    "default_title": "Open TwoSubs Sidebar",
    "default_icon": "src/icons/twosubs.png"
  },
  "sidebar_action": {
    "default_title": "TwoSubs",
    "default_panel": "dist-popup/popup.html",
    "default_icon": "src/icons/twosubs.png",
    "open_at_install": false
  },
  "background": {
    "scripts": ["src/background.js"]
  }
}
